# ==========================================
# BITÁCORA SEMANAL PRO - VARIABLES DE ENTORNO
# ==========================================

# 1. Supabase (Base de datos PostgreSQL en la nube)
# Obtén estas credenciales en https://supabase.com -> Tu Proyecto -> Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# 2. Gmail SMTP (Para enviar reportes semanales por correo)
# Obtén tu Contraseña de Aplicación en:
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activa)
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# 3. Opcional: Clave secreta para proteger el endpoint de envío de correo en Vercel
API_SECRET_KEY=mi_clave_secreta_opcional
